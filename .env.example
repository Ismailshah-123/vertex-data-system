# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local — it's already excluded in .gitignore.
# When deploying to Vercel, add these same variables in
# Project Settings → Environment Variables instead of a file.

# Required for the contact form to actually send emails.
# Sign up at https://resend.com, verify your domain, then create an API key.
# Without this set, form submissions are logged to the server console
# instead of emailed — useful for local testing, not for production.
RESEND_API_KEY=

# Where contact form submissions get sent. Defaults to hello@vertexdata.systems
# if not set.
CONTACT_EMAIL=
